{
  "manifest_version": 3,
  "name": "Bilibili Vocabulary Subtitle",
  "version": "0.1.0",
  "description": "在 Bilibili 字幕中自动插入英文词汇，帮助被动学习英语",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://www.youtube.com/*",
    "https://v.qq.com/*",
    "https://www.iqiyi.com/*",
    "https://www.netflix.com/*",
    "https://v.youku.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "config.js",
        "settingsUiStateMachine.js",
        "sharedSettings.js",
        "experienceMetrics.js",
        "adaptiveTuning.js",
        "learningState.js",
        "utils.js",
        "segmenter.js",
        "vocabulary.js",
        "translator.js",
        "renderer.js",
        "subtitleParser.js",
        "scripts/danmaku.js",
        "scripts/scheduler.js",
        "tooltip.js",
        "subtitleNavigation.js",
        "contentScript.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dist/options.html",
  "action": {
    "default_title": "Bilibili Vocabulary Subtitle",
    "default_popup": "dist/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/*.json",
        "dist/overlay.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "开关字幕替换功能"
    },
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "开关悬浮控制面板"
    },
    "increase-ratio": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "提高词汇替换比例"
    },
    "decrease-ratio": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "降低词汇替换比例"
    }
  }
}
